<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Minesweeper.Views"
             x:Class="Minesweeper.Views.LevelsPage"
             BackgroundColor="{StaticResource MilkBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="6,8">
            <Button Grid.Column="0" Text="{x:Static views:Icons.ArrowBack}" FontSize="22" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center" Margin="6,0,0,0">
                <Label Text="Tutorial — 100 màn" Style="{StaticResource TitleText}" FontSize="19" />
                <Label x:Name="StatsLabel" Style="{StaticResource Hint}" />
            </VerticalStackLayout>
        </Grid>

        <CollectionView x:Name="LevelsCollection" Grid.Row="1" Margin="14,4,14,14">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:LevelItem">
                    <Border BackgroundColor="{StaticResource SurfaceTonal}" Stroke="Transparent" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="0" HeightRequest="64" Opacity="{Binding CardOpacity}">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,3" />
                        </Border.Shadow>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                <Setter Property="StrokeThickness" Value="2.5" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLevelTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding NumberText}" FontFamily="OpenSansSemibold" FontSize="16" HorizontalOptions="Center" />
                            <Label Text="{Binding StarsText}" FontSize="10" TextColor="{StaticResource Accent}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
