<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Minesweeper.Views"
             xmlns:strings="clr-namespace:Minesweeper.Resources.Strings"
             x:Class="Minesweeper.Views.PrivacyPolicyPage"
             Title="{x:Static strings:AppStrings.Common_PrivacyPolicy}"
             BackgroundColor="{DynamicResource MilkBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="PolicyHeading" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="PolicyBody" TargetType="Label">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="1.4" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="6,8">
            <Button Grid.Column="0" Text="{x:Static views:Icons.ArrowBack}" Padding="0, 0" Margin="0, 0" FontSize="22" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="{x:Static strings:AppStrings.Common_PrivacyPolicy}" Style="{StaticResource TitleText}" FontSize="17" VerticalOptions="Center" Margin="6,0,0,0" LineBreakMode="TailTruncation" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,28">
                <Label x:Name="UpdatedLabel" Style="{StaticResource Hint}" />

                <Label Text="{x:Static strings:AppStrings.Privacy_Overview_Heading}" Style="{StaticResource PolicyHeading}" />
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_Overview_Body}" />

                <Label Text="{x:Static strings:AppStrings.Privacy_DirectData_Heading}" Style="{StaticResource PolicyHeading}" />
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_DirectData_Body}" />

                <Label Text="{x:Static strings:AppStrings.Privacy_ThirdParty_Heading}" Style="{StaticResource PolicyHeading}" />
                <!-- Reuses TermsGate_Paragraph3 verbatim (same fact, same already-localized string in all 11
                     locales, added 2026-11-12 for the terms gate) instead of a new Privacy_* resx key —
                     avoids touching all 11 AppStrings*.resx files again for an identical sentence. -->
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.TermsGate_Paragraph3}" TextColor="{DynamicResource OffBlack}" Margin="0,0,0,6" />
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_ThirdParty_Intro}" />
                <VerticalStackLayout Spacing="10" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{x:Static strings:AppStrings.Privacy_LevelPlay_Title}" FontFamily="OpenSansSemibold" FontSize="13" />
                            <Label Style="{StaticResource Hint}" Text="{x:Static strings:AppStrings.Privacy_LevelPlay_Body}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{x:Static strings:AppStrings.Privacy_Billing_Title}" FontFamily="OpenSansSemibold" FontSize="13" />
                            <Label Style="{StaticResource Hint}" Text="{x:Static strings:AppStrings.Privacy_Billing_Body}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <Label Style="{StaticResource PolicyBody}" Margin="0,10,0,0" Text="{x:Static strings:AppStrings.Privacy_ThirdParty_Outro}" />
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_UnityLink}" />
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_GoogleLink}" />

                <Label Text="{x:Static strings:AppStrings.Privacy_Permissions_Heading}" Style="{StaticResource PolicyHeading}" />
                <Border Style="{StaticResource Card}">
                    <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_Permissions_Body}" />
                </Border>

                <Label Text="{x:Static strings:AppStrings.Privacy_Children_Heading}" Style="{StaticResource PolicyHeading}" />
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_Children_Body}" />

                <Label Text="{x:Static strings:AppStrings.Privacy_DataRetention_Heading}" Style="{StaticResource PolicyHeading}" />
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_DataRetention_Body}" />

                <Label Text="{x:Static strings:AppStrings.Privacy_PolicyChanges_Heading}" Style="{StaticResource PolicyHeading}" />
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_PolicyChanges_Body}" />

                <Label Text="{x:Static strings:AppStrings.Privacy_Contact_Heading}" Style="{StaticResource PolicyHeading}" />
                <Label Style="{StaticResource PolicyBody}" Text="{x:Static strings:AppStrings.Privacy_Contact_Body}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
