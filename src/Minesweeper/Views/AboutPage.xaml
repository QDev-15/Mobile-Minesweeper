<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Minesweeper.Views"
             x:Class="Minesweeper.Views.AboutPage"
             Title="Giới thiệu"
             BackgroundColor="{DynamicResource MilkBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="6,8">
            <Button Grid.Column="0" Text="{x:Static views:Icons.ArrowBack}" Padding="0, 0" Margin="0, 0" FontSize="22" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="Giới thiệu" Style="{StaticResource TitleText}" FontSize="19" VerticalOptions="Center" Margin="6,0,0,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="10">
                <Label Text="Dò Mìn" Style="{StaticResource DisplayText}" FontSize="24" />
                <Label x:Name="VersionLabel" TextColor="{DynamicResource InkSoft}" />
                <Label Text="Minesweeper cổ điển với 2 điểm khác: chế độ Không đoán mù (mọi bàn giải được bằng logic thuần) và Thử thách hôm nay (bàn giống nhau cho mọi người mỗi ngày)." Margin="0,10,0,0" />
                <Label Text="Phát triển bởi Nguyễn Hữu Quỳnh." Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
