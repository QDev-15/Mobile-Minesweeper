<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ads="clr-namespace:AdsService;assembly=AdsService"
             xmlns:views="clr-namespace:Minesweeper.Views"
             x:Class="Minesweeper.Views.GamePage"
             BackgroundColor="{DynamicResource MilkBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Top bar: back, mine counter, timer, hint, restart. Hint/restart hide once the round ends (see
             ResultBanner below), which pops up its own Quay lại/Chơi lại/Đóng actions instead. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Padding="10,10" ColumnSpacing="8">
            <Button Grid.Column="0" Text="{x:Static views:Icons.ArrowBack}" FontSize="22" Padding="0,0" Margin="0" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />

            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="{x:Static views:Icons.Flag}" FontFamily="Icons" FontSize="16" TextColor="{DynamicResource Accent}" VerticalOptions="Center" />
                    <Label x:Name="MineCountLabel" Style="{StaticResource TitleText}" FontSize="17" VerticalOptions="Center" />
                    <Label x:Name="TimerLabel" Style="{StaticResource TitleText}" FontSize="17" VerticalOptions="Center" Text="0:00" Margin="14,0,0,0" />
                </HorizontalStackLayout>
                <!-- Daily-mode badge (design spec §3.2): nothing else on this page distinguishes a Daily
                     Challenge board from an ordinary Medium game once play starts, so this small pill is
                     the only cue — shown/hidden from code-behind via _isDaily, same idea as HomePage's own
                     "HÔM NAY" badge on its Daily card. Sits in Row 0's own Auto height, so it never
                     overlaps the board below. -->
                <Label x:Name="DailyBadge" Text="Thử thách hôm nay" FontFamily="OpenSansSemibold" FontSize="10"
                       TextColor="{DynamicResource OffBlack}" BackgroundColor="{DynamicResource Accent}"
                       Padding="8,2" HorizontalOptions="Center" IsVisible="False" />
            </VerticalStackLayout>

            <Button x:Name="HintButton" Grid.Column="2" Padding="0,0" Margin="0" Text="{x:Static views:Icons.LightbulbOutline}" FontSize="22" Style="{StaticResource IconButton}" Clicked="OnHintClicked" />
            <Button x:Name="RestartButton" Grid.Column="3" Padding="0,0" Margin="0" Text="{x:Static views:Icons.RestartAlt}" FontSize="22" Style="{StaticResource IconButton}" Clicked="OnRestartClicked" />
        </Grid>

        <!-- Board: RefreshAllCells reveals every mine on a loss as usual; the ResultBanner modal below dims
             it but the finished board is still visible underneath once "Đóng" closes that modal.

             No ScrollView any more (owner's direction, 2026-10-20: the board must NEVER need scrolling to be
             seen in full). BoardArea fills this whole row; BuildEmptyBoard measures its actual pixel size and
             computes a cell size from it (Width/Height both constrained, a 10px margin baked into the sum),
             so BoardHost always lands at or under BoardArea's size and just sits centered inside it. -->
        <Grid x:Name="BoardArea" Grid.Row="1" HorizontalOptions="Fill" VerticalOptions="Fill">
            <!-- AbsoluteLayout, not Grid: a Grid re-evaluates its RowDefinitions/ColumnDefinitions star-sizing
                 across every already-added child each time one more is inserted, which made populating 288
                 uniform, fixed-size cells one Children.Add at a time cost 6+ seconds on a real device (measured
                 2026-10-22: ~3.5s building the Border/Label objects, ~3s just adding them to the Grid). Every
                 cell here is the same fixed pixel size placed at an exact (x*cellSize, y*cellSize) offset, which
                 is exactly what AbsoluteLayoutFlags.None bounds are for, with none of the Grid's per-insert
                 re-layout cost. -->
            <AbsoluteLayout x:Name="BoardHost" HorizontalOptions="Center" VerticalOptions="Center" />
            <!-- No-guess board generation (always on for the Daily Challenge, optional otherwise) can take a
                 real moment on a slow device, and was running synchronously on the UI thread with nothing
                 shown for it, which read as the app freezing (owner's report, 2026-10-20). It now runs on a
                 background thread (StartGameFromAsync/LoadDailyBoardAsync) while this scrim sits on top of
                 BoardHost in the same Grid cell: it both gives real loading feedback and, just by being a
                 later, opaque sibling in the same cell, blocks taps from reaching the still-Hidden cells
                 underneath until a real board exists under them. -->
            <Grid x:Name="BoardLoadingOverlay" IsVisible="False" BackgroundColor="{DynamicResource MilkBackground}" Opacity="0.94">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <ActivityIndicator x:Name="BoardLoadingSpinner" Color="{DynamicResource Primary}" WidthRequest="42" HeightRequest="42" />
                    <Label Text="Đang tạo bàn chơi…" Style="{StaticResource Hint}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
            <!-- Per-mine "burst" debris (owner follow-up, 2026-10-22: the ring-by-ring spread needed an actual
                 scatter effect per cell, not just the 💣 color-swap pop). A single GraphicsView, not one native
                 view per particle (see the ParticleField class comment in GamePage.xaml.cs, near
                 AnimateMineExplosionRippleAsync, for why) — SpawnMineBurst adds Particle records to the
                 code-behind-owned ParticleField wrapping this view; it draws nothing and costs nothing while
                 empty, so it never needs an outer IsVisible toggle. A LATER sibling than BoardHost/
                 BoardLoadingOverlay so sparks render on top of the board; InputTransparent so it never steals
                 taps from the still-live cells underneath it. -->
            <GraphicsView x:Name="MineBurstLayer" InputTransparent="True" />
        </Grid>

        <ads:AdBannerSurface x:Name="Banner" Grid.Row="3" />

        <!-- Game-end modal (owner's direction, 2026-10-21: win/loss must interrupt as a real popup with
             choices, not a quiet inline banner with the top bar's back button as the only way out). Spans
             every row so it sits over the whole page including the toolbar/banner, with a dimmed scrim behind
             a centered card — the board stays visible (dimmed) underneath so "Đóng" can still let the player
             look back at the finished board, same as before.

             Win/loss redesign (2026-10-22): the same Border/card is still reused for both outcomes (ONLY its
             BackgroundColor/Stroke/icon/title color are swapped from code, in HandleGameEndIfNeeded), rather
             than two separate card trees, so the two outcomes stay visually consistent with each other and
             with the rest of the app's Card style — just re-themed per outcome, not two independently
             designed popups. ResultIconLabel is mood_bad (loss) or check_circle (win), both already
             circle-enclosed Material glyphs, so no extra badge/circle wrapper is needed around either. -->
        <Grid x:Name="ResultBanner" Grid.RowSpan="4" BackgroundColor="#B3000000" IsVisible="False">
            <Border x:Name="ResultCard" Style="{StaticResource Card}" Margin="28" VerticalOptions="Center">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label x:Name="ResultIconLabel" FontFamily="Icons" FontSize="52" HorizontalOptions="Center" Margin="0,0,0,2" />
                    <Label x:Name="ResultTitleLabel" Style="{StaticResource TitleText}" FontSize="21" HorizontalOptions="Center" />
                    <Label x:Name="StarsLabel" FontSize="22" TextColor="{DynamicResource Accent}" HorizontalOptions="Center" IsVisible="False" />
                    <Label x:Name="ResultDetailLabel" FontSize="13.5" TextColor="{DynamicResource InkSoft}" HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,14,0,0">
                        <Button Grid.Column="0" Text="Quay lại" Clicked="OnResultBackClicked"
                                BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource Primary}"
                                BorderWidth="1.5" FontFamily="OpenSansSemibold" CornerRadius="20" HeightRequest="46" />
                        <Button Grid.Column="1" Text="Chơi lại" Clicked="OnResultRestartClicked" Style="{StaticResource PrimaryButton}" HeightRequest="46" />
                    </Grid>
                    <Button Text="Đóng" Clicked="OnResultCloseClicked" BackgroundColor="Transparent" TextColor="{DynamicResource InkSoft}"
                            FontFamily="OpenSansSemibold" FontSize="13.5" HeightRequest="36" Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Win-only confetti, built and started from code-behind (StartWinCelebration) — same GraphicsView-
                 backed ParticleField as MineBurstLayer above (see that element's own comment), not an icon/
                 glyph effect (there is no confetti glyph, and a particle effect reads far better than a single
                 static symbol). Sits as a LATER sibling than the card above so pieces can fall in front of it
                 too, like real confetti would. InputTransparent so it never blocks the card's own buttons
                 underneath it. -->
            <GraphicsView x:Name="ConfettiLayer" InputTransparent="True" />
        </Grid>
    </Grid>
</ContentPage>
