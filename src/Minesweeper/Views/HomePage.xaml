<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ads="clr-namespace:AdsService;assembly=AdsService"
             xmlns:views="clr-namespace:Minesweeper.Views"
             x:Class="Minesweeper.Views.HomePage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Right padding 12->20->44 (2026-10-19, same day): turned out NOT to be the fix, moving the whole
             button via more Grid padding left its clipped glyph pixel-for-identical, proving this was never
             about screen position. The first two padding attempts also shipped WHILE Icons.HelpOutline/Tune
             happened to be empty strings (see Icons.cs's own comment), so neither was ever actually visually
             verified until now. Real cause, found once the glyphs were visible to compare: help_outline and
             tune specifically self-clip on their own right edge inside a 40dp IconButton at FontSize 20,
             while ArrowBack (FontSize 22, same 40dp IconButton, GamePage/SettingsPage/LevelsPage/AboutPage/
             PrivacyPolicyPage) and every other glyph in this app render fully intact at that same button
             size, so it is specific to these 2 glyphs' own metrics in MaterialIcons-Regular.ttf, not the
             button or the corner. Fix: smaller FontSize for just these two. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Padding="20,24,20,8">
            <Label Grid.Column="0" Text="Dò Mìn" Style="{StaticResource DisplayText}" TextColor="{DynamicResource OffBlack}" />
            <Button x:Name="ProBadge" Grid.Column="1" Text="PRO" FontSize="11" FontFamily="OpenSansSemibold" TextColor="White"
                    BackgroundColor="{DynamicResource Accent}" CornerRadius="14" Padding="12,0" HeightRequest="28"
                    VerticalOptions="Center" Margin="0,0,6,0" Clicked="OnProBadgeClicked" />
            <!-- FontSize 18 + a 46dp box, not the shared IconButton style's default 40dp (owner's direction,
                 2026-10-20: these read too small at 16sp): HelpOutline/Tune specifically self-clip past about
                 a 0.4 ratio of glyph size to box size in this font (confirmed on a real device, see Icons.cs's
                 Event comment for the same glyph-specific issue on a different icon). Every other IconButton
                 in the app stays at the default 40dp box and is unaffected. -->
            <Button Grid.Column="2" Text="{x:Static views:Icons.HelpOutline}" FontSize="22" Padding="0, 0" Margin="0, 0" Style="{StaticResource IconButton}"
                    WidthRequest="46" HeightRequest="46" Clicked="OnAboutClicked" />
            <Button Grid.Column="3" Text="{x:Static views:Icons.Tune}" Padding="0, 0" Margin="0, 0" FontSize="22" Style="{StaticResource IconButton}"
                    WidthRequest="46" HeightRequest="46" Clicked="OnSettingsClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8" Spacing="14">

                <Border x:Name="ResumeCard" Style="{StaticResource Card}" BackgroundColor="{DynamicResource PrimarySoft}" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Ván đang chơi dở" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{DynamicResource OffBlack}" />
                            <Label x:Name="ResumeDetailLabel" FontSize="12.5" TextColor="{DynamicResource OffBlack}" Opacity="0.75" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Tiếp tục" TextColor="Gray" Clicked="OnResumeClicked" BackgroundColor="{DynamicResource OffBlack}"
                                FontFamily="OpenSansSemibold" CornerRadius="20" WidthRequest="100" HeightRequest="40" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- The whole card opens DailyCalendarPage now (owner's direction, 2026-10-20: the dedicated
                     calendar-icon button and the separate "Chơi ngay" button both read as unclear/low-contrast
                     glyphs on-device, and splitting "open calendar" from "play today" into two small controls
                     was redundant anyway) — pick a day there, Chơi ngay on THAT page is what actually starts
                     a game, defaulting to today. -->
                <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource Primary}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDailyCardTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="HÔM NAY" FontFamily="OpenSansSemibold" FontSize="10.5" TextColor="White" Opacity="0.85"
                               BackgroundColor="#33FFFFFF" Padding="9,3" HorizontalOptions="Start" VerticalOptions="Center" />
                        <Label Text="Thử thách hôm nay" Style="{StaticResource TitleText}" TextColor="White" />
                        <Label x:Name="DailyDateLabel" FontSize="13" TextColor="#E0E8FF" />
                        <Label Text="Bàn giống nhau cho mọi người, giải được 100% bằng suy luận — không phải đoán." FontSize="12.5" TextColor="#E0E8FF" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTutorialTapped" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Tutorial" FontFamily="OpenSansSemibold" FontSize="16" />
                            <Label x:Name="TutorialProgressLabel" FontSize="12.5" TextColor="{DynamicResource InkSoft}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{x:Static views:Icons.ChevronRight}" FontFamily="Icons" FontSize="20" TextColor="{DynamicResource InkSoft}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label Text="CHƠI THƯỜNG" FontSize="12.5" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Primary}" Margin="4,10,0,0" />

                <Border x:Name="EasyCard" Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Dễ" FontFamily="OpenSansSemibold" FontSize="16" />
                        <Label x:Name="EasyBestLabel" Grid.Row="1" FontSize="12" TextColor="{DynamicResource InkSoft}" />
                        <Button Grid.Column="1" Grid.RowSpan="2" Text="Chơi" Style="{StaticResource PrimaryButton}" WidthRequest="84" HeightRequest="38"
                                Clicked="OnEasyClicked" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="MediumCard" Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Vừa" FontFamily="OpenSansSemibold" FontSize="16" />
                        <Label x:Name="MediumBestLabel" Grid.Row="1" FontSize="12" TextColor="{DynamicResource InkSoft}" />
                        <Button Grid.Column="1" Grid.RowSpan="2" Text="Chơi" Style="{StaticResource PrimaryButton}" WidthRequest="84" HeightRequest="38"
                                Clicked="OnMediumClicked" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="HardCard" Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Khó" FontFamily="OpenSansSemibold" FontSize="16" />
                        <Label x:Name="HardBestLabel" Grid.Row="1" FontSize="12" TextColor="{DynamicResource InkSoft}" />
                        <Button Grid.Column="1" Grid.RowSpan="2" Text="Chơi" Style="{StaticResource PrimaryButton}" WidthRequest="84" HeightRequest="38"
                                Clicked="OnHardClicked" VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <ads:AdBannerSurface x:Name="Banner" Grid.Row="2" />
    </Grid>
</ContentPage>
