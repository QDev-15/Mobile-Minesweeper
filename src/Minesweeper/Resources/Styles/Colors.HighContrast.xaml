<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Minesweeper.ColorsHighContrast">

    <!-- Dò Mìn, high-contrast theme (2026-10-19 "trắng sữa" redesign §1.4): exact same key set as
         Colors.Light.xaml/Colors.Dark.xaml, so every page that reads a color by name stays correct with no
         per-page changes. Pure black/white base (not just a darker dark theme) with near-maximum
         CellHidden/CellRevealed luminance separation, and a Number1-8 set re-picked for colorblind
         legibility rather than lightened/darkened from the other two themes' hues. Manually selected from
         SettingsPage (App.xaml.cs's RequestedTheme-driven auto-switch stays Light/Dark only — this theme
         is opt-in, never chosen automatically by the OS setting). -->
    <Color x:Key="Primary">#5C8CFF</Color>
    <Color x:Key="PrimarySoft">#10204A</Color>
    <Color x:Key="Accent">#FFC233</Color>
    <Color x:Key="AccentSoft">#3A2900</Color>
    <Color x:Key="Danger">#FF5C42</Color>
    <!-- Success/DangerSoft added 2026-10-22, same reasoning as the other two theme files — Success matches
         Number2's high-contrast green, DangerSoft is a near-black muted-red tint (same pattern AccentSoft
         uses in this file). -->
    <Color x:Key="Success">#81C784</Color>
    <Color x:Key="DangerSoft">#330000</Color>

    <Color x:Key="MilkBackground">#000000</Color>
    <Color x:Key="SurfaceTonal">#121212</Color>
    <Color x:Key="HairLine">#FFFFFF</Color>
    <Color x:Key="InkSoft">#CFCFCF</Color>
    <Color x:Key="OffBlack">#FFFFFF</Color>

    <!-- Board cells: maximum luminance gap between hidden (deep blue) and revealed (near-black) so the
         board's basic hidden/open readability holds even for low-vision players. -->
    <Color x:Key="CellHidden">#1E3A8A</Color>
    <Color x:Key="CellHiddenPressed">#15297A</Color>
    <Color x:Key="CellRevealed">#1A1A1A</Color>
    <Color x:Key="CellMine">#FF3B30</Color>

    <!-- Number1-8: re-picked for colorblind legibility (not a lightened/darkened pass like Colors.Dark.xaml
         did from Colors.Light.xaml) — hue AND lightness both vary across the set, so no two numbers rely
         on hue alone to be told apart. 7/8 stay white/light-gray, matching OffBlack/InkSoft's own
         light-on-black role in this theme, same pattern as Colors.Dark.xaml uses for its own dark surface. -->
    <Color x:Key="Number1">#64B5F6</Color>
    <Color x:Key="Number2">#81C784</Color>
    <Color x:Key="Number3">#FF5252</Color>
    <Color x:Key="Number4">#CE93D8</Color>
    <Color x:Key="Number5">#FFB74D</Color>
    <Color x:Key="Number6">#4DD0E1</Color>
    <Color x:Key="Number7">#FFFFFF</Color>
    <Color x:Key="Number8">#D8D8D8</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="MilkBackgroundBrush" Color="{StaticResource MilkBackground}" />
    <SolidColorBrush x:Key="SurfaceTonalBrush" Color="{StaticResource SurfaceTonal}" />
    <SolidColorBrush x:Key="HairLineBrush" Color="{StaticResource HairLine}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
</ResourceDictionary>
