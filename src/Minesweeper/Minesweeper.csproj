<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only for now (no Mac for iOS), same decision as the sibling PdfReader/DocScanner repos. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Minesweeper</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance (same
		     performance lesson as PdfReader/DocScanner: Debug falls back to runtime inflation + the Mono
		     interpreter, which reads as "app chậm" when it is really just a Debug build). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Dò Mìn</ApplicationTitle>
		<ApplicationId>com.tonyq.minesweeper</ApplicationId>

		<!-- Versions. Bump ApplicationVersion (Android versionCode) on every build going to a device or to Play.
		     Release .aab, run from the repo root (test ads — the default, see AdsMode below):
		       dotnet publish src/Minesweeper -f net10.0-android -c Release -p:AndroidPackageFormat=aab
		     (AndroidPackageFormat=aab is already the default here via release\Signing.props, so it can be left
		     off; kept in the example for the same clarity as PdfReader/DocScanner's own command, where it is
		     not already defaulted.) Lands signed at bin\Release\net10.0-android\publish\ and, via
		     CopyReleaseAabWithVersion below, also at release\Minesweeper-<version>-<code>\. -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>4</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

		<!-- Ads mode: independent of Configuration (Debug/Release) and of APK vs AAB. "Dev" (the default,
		     if not passed on the command line) always requests the provider's own test/sandbox ad units,
		     whatever is being built, so a Release .aab uploaded to a Play internal/closed testing track
		     still shows test ads and can never trigger an invalid-click policy strike. Only "Pro" switches
		     to the real ids (RealAdsConfig.cs), and only when explicitly passed:
		       dotnet publish src/Minesweeper -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsMode=Pro
		     same pattern as PdfReader/DocScanner (not yet wired here: Minesweeper has no LevelPlay app/ad units
		     of its own yet, see MINESWEEPER-PLAN.md section 7, so this flag has no real ids to switch to today). -->
		<AdsMode Condition="'$(AdsMode)' == ''">Dev</AdsMode>
		<DefineConstants Condition="'$(AdsMode)' == 'Pro'">$(DefineConstants);ADS_MODE_PRO</DefineConstants>

		<!-- Ads kill switch for a Play Console testing build, same meaning as PdfReader/DocScanner's own
		     AdsEnabled: 
			 dotnet publish Minesweeper -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsMode=Pro -p:AdsEnabled=true
			 dotnet publish Minesweeper -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsMode=Dev -p:AdsEnabled=true
			 dotnet publish Minesweeper -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsMode=Dev -p:AdsEnabled=false -->
		<AdsEnabled Condition="'$(AdsEnabled)' == ''">true</AdsEnabled>
		<DefineConstants Condition="'$(AdsEnabled)' == 'false'">$(DefineConstants);ADS_DISABLED</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- Profiled AOT + RunAOTCompilation (owner's report, 2026-10-22: "Chơi" still felt slow to navigate
		     to even from a Release .aab on a real device) — per Microsoft's own .NET 8 MAUI Android
		     benchmark post, Profiled AOT is the recommended middle ground for Release builds (smallest
		     measured APK of the AOT options there, real cold-start improvement) and "should be enabled by
		     default for Release builds"; this project had it explicitly OFF with no comment explaining why.
		     RunAOTCompilation is required alongside it (Mono.Profiler.Android's own README). Trade-off:
		     longer build time and a larger APK than no-AOT-at-all (though still smaller than full AOT per
		     that same benchmark) — acceptable here since startup/navigation speed is the actual complaint,
		     not install size. Needs a real before/after measurement on-device, not just a build-time guess.
		     Some of the remaining gap (Shell does not cache pages — every navigation to a route not already
		     on the stack constructs a brand-new page from scratch, by design) is NOT fixable by any of this:
		     Microsoft's own benchmark shows even a bare non-Shell MAUI Android app cold-starts around 464ms
		     vs. ~182ms for a plain native Android app, so "Chơi" will never feel literally as instant as the
		     hardware Back button (which returns to an already-alive HomePage, nothing to construct). -->
		<AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
		<RunAOTCompilation>true</RunAOTCompilation>
		<EnableLLVM>true</EnableLLVM>
	</PropertyGroup>

	<!-- Release signing (Google Play upload key): keystore + passwords are NOT in this file. A new, separate
	     keystore (not PdfReader's/DocScanner's) must be created before any Release/Play build. -->
	<Import Project="release\Signing.props" Condition="'$(Configuration)' == 'Release' AND Exists('release\Signing.props')" />
<!-- dotnet publish's own output already lands the signed bundle in bin\Release\net10.0-android\publish\,
	     named "<ApplicationId>-Signed.aab"; easy to lose track of across several builds (Dev/Pro ads, with/
	     without ads, different days) since every one overwrites the same generic name in a folder buried under
	     bin\. Also copies it to release\ (the same gitignored folder Signing.props + the upload keystore already
	     live in, see .gitignore's "[Rr]elease/" rule, so this can never end up committed) with the app's own
	     display version + version code baked into the file name, so old builds just sit there named for what
	     they are instead of being overwritten. Does not delete/replace dotnet publish's own copy, only adds this
	     one; only fires for a Release .aab build (Signing.props is what actually sets AndroidPackageFormat=aab). -->
	<Target Name="CopyReleaseAabWithVersion" AfterTargets="Publish"
	        Condition="'$(Configuration)' == 'Release' AND '$(AndroidPackageFormat)' == 'aab'">
		<ItemGroup>
			<_SignedAab Include="$(PublishDir)*-Signed.aab" />
		</ItemGroup>
		<!-- One folder per build, release\Minesweeper-<version>-<code>\, holding the bundle and the R8 mapping.txt of that
		     exact build (every build makes a different mapping; keep the pair together). The mapping is also inside the
		     .aab itself (BUNDLE-METADATA), so Play needs no separate upload; this copy is for manual upload / archive. -->
		<PropertyGroup>
			<_ReleaseName>Minesweeper-$(ApplicationDisplayVersion)-$(ApplicationVersion)</_ReleaseName>
			<_ReleaseDir>release\$(_ReleaseName)\</_ReleaseDir>
			<_ReleaseMapping>$(OutputPath)mapping.txt</_ReleaseMapping>
		</PropertyGroup>
		<!-- Warn when the build was NOT obfuscated (this project does not set AndroidR8ObfuscationMode at all
		     yet, unlike PdfReader/DocScanner, so this always fires today — a reminder, not a blocker): such an
		     AAB keeps Play's "DEX code optimization" obfuscation score below 25%. There is no build-release.ps1
		     in this repo (that script, which points dotnet at a newer Android SDK supporting
		     AndroidR8ObfuscationMode, only exists in the sibling PdfReader/DocScanner repos) — adopting real
		     obfuscation here means doing the same setup there first. -->
		<ReadLinesFromFile File="$(IntermediateOutputPath)proguard\proguard_xamarin.cfg" Condition="Exists('$(IntermediateOutputPath)proguard\proguard_xamarin.cfg')">
			<Output TaskParameter="Lines" ItemName="_ProguardXamarinLine" />
		</ReadLinesFromFile>
		<ItemGroup>
			<_NoObfuscationLine Include="@(_ProguardXamarinLine)" Condition="'%(Identity)' == '-dontobfuscate'" />
		</ItemGroup>
		<Warning Condition="'@(_NoObfuscationLine)' != ''" Text="This build is NOT obfuscated (AndroidR8ObfuscationMode not set in this project; see the comment above)." />
		<MakeDir Directories="$(_ReleaseDir)" Condition="'@(_SignedAab)' != ''" />
		<Copy SourceFiles="@(_SignedAab)" DestinationFiles="$(_ReleaseDir)$(_ReleaseName).aab" Condition="'@(_SignedAab)' != ''" />
		<Copy SourceFiles="$(_ReleaseMapping)" DestinationFiles="$(_ReleaseDir)mapping.txt" Condition="'@(_SignedAab)' != '' AND Exists('$(_ReleaseMapping)')" />
		<Message Importance="high" Condition="'@(_SignedAab)' != ''" Text="Release build copied to $(_ReleaseDir) (aab + mapping.txt)" />
	</Target>
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B2A4A" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F4F1EA" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('Resources\Raw')" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- MIT: Play Billing wrapper for the Pro unlock (Services/LicenseService.cs), same pattern as
		     PdfReader/DocScanner. -->
		<PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
		<!-- MIT: short gameplay sound effects (Services/SoundService.cs) — same author/ecosystem as
		     Plugin.InAppBilling above. Targets net9.0-android in its own nuspec but resolves fine under this
		     project's net10.0-android (newer TFM consuming an older-targeted MAUI lib), confirmed by building
		     after adding it, 2026-10-20. -->
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
		<!-- Pins androidx.fragment to one resolved version: without it, AdsService.LevelPlay's own
		     transitive fragment-ktx.aar and the plain fragment.aar pulled in elsewhere resolve to two
		     different versions, and R8 fails with "Type androidx.fragment.app.FragmentManagerKt is defined
		     multiple times": same fix as PdfReader/DocScanner's own csproj. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Minesweeper.Core\Minesweeper.Core.csproj" />
		<ProjectReference Include="..\AdsService.LevelPlay\AdsService.LevelPlay.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="release\" />
	</ItemGroup>

</Project>
