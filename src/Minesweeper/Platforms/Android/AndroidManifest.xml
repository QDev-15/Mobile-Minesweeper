<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Marks the app as a game at the OS level: android:appCategory is the current, non-deprecated signal
	     (ApplicationInfo.CATEGORY_GAME), android:isGame is the older one — GameManager.java (AOSP) accepts
	     either. Together these are what Samsung's Game Launcher / other OEM "gaming hub" features and
	     Android's own category-based grouping (Digital Wellbeing, storage/data usage by category) key off of
	     at the manifest level. Note: Samsung's own support docs say automatic Game Launcher detection is
	     mainly driven by the Play Store listing's app category ("Games > Puzzle"), which is chosen separately
	     in Play Console when setting up the store listing, not by this manifest flag alone — both need to be
	     set for reliable gaming-hub placement. -->
	<application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"
	             android:isGame="true" android:appCategory="game">

		<!-- Mandatory regardless of which ad network is actually active (LevelPlay here, see
		     MauiProgram.cs): AdsService.Core depends on the Google Mobile Ads SDK's manifest-declared
		     ContentProvider (MobileAdsInitProvider), which runs automatically at app process start and
		     throws IllegalStateException("Missing application ID") if this meta-data is absent: the exact
		     crash PdfReader hit on 2026-10-11 before this was understood. Google's own published TEST App ID
		     always satisfies this startup check; using it here is fine precisely because AdMob is never
		     actually used to request or show a real ad in this app. -->
		<meta-data android:name="com.google.android.gms.ads.APPLICATION_ID"
		           android:value="ca-app-pub-3940256099942544~3347511713" />
		<activity android:name="com.google.android.gms.ads.AdActivity"
		          android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
		          android:theme="@android:style/Theme.Translucent" android:exported="false" />
	</application>

	<!-- Google Play Billing (bản Pro tắt ads) + LevelPlay ads: no server of our own, mọi dữ liệu game ở lại
	     trên máy. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!-- Required since Android 13 (API 33): without it the system zeroes out the Advertising ID for every
	     app on the device. LevelPlay (the active ad provider) uses it for ad targeting/attribution, and
	     Play Console's own upload check rejects a release whose manifest lacks this permission when the
	     app's "Advertising ID" declaration (App content) says the app uses it: same lesson learned on
	     PdfReader 2026-10-12. -->
	<uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
